-- Semesters: fixed reference data. Every admission cycle has exactly two
-- intakes, so both rows are seeded here and never inserted or deleted by the app.
-- closed_after_call holds the number of the last call when the semester was
-- closed (NULL = open); a closed semester receives no one in later calls.
CREATE TABLE semesters (
  number            INTEGER NOT NULL PRIMARY KEY CHECK (number IN (1, 2)),
  closed_after_call INTEGER DEFAULT NULL
);

INSERT INTO semesters (number) VALUES (1), (2);

-- Selections
CREATE TABLE selections (
  id          INTEGER NOT NULL PRIMARY KEY,
  kind        TEXT UNIQUE NOT NULL CHECK ( kind IN ('approved', 'waitlist') ),
  name        TEXT NOT NULL,
  year        INTEGER NOT NULL,
  institution TEXT NOT NULL,
  degree      TEXT NOT NULL
);

-- Calls
CREATE TABLE calls (
  id          INTEGER NOT NULL PRIMARY KEY,
  number      INTEGER UNIQUE NOT NULL,
  status      TEXT NOT NULL CHECK ( status IN ('calling', 'done') )
);

CREATE UNIQUE INDEX idx_one_active_call ON calls(status) WHERE status = 'calling';

-- Quotas
CREATE TABLE quotas (
  id   INTEGER NOT NULL PRIMARY KEY,
  name TEXT NOT NULL UNIQUE
);

-- Courses
CREATE TABLE courses (
  id            INTEGER NOT NULL PRIMARY KEY,
  time_slot     TEXT NOT NULL CHECK ( time_slot IN ('morning', 'evening') ),
  quota_id      INTEGER NOT NULL REFERENCES quotas ON DELETE RESTRICT ON UPDATE RESTRICT,
  seats         INTEGER NOT NULL,
  minimum_score INTEGER NOT NULL
);

CREATE UNIQUE INDEX idx_course_time_slot_quota ON courses(time_slot, quota_id);

-- Candidates
CREATE TABLE candidates (
  id             INTEGER NOT NULL PRIMARY KEY,
  cpf            TEXT NOT NULL UNIQUE,
  name           TEXT NOT NULL,
  social_name    TEXT NOT NULL,
  birthdate      TEXT NOT NULL,
  sex            TEXT NOT NULL,
  mother_name    TEXT NOT NULL,
  address_line   TEXT NOT NULL,
  address_line2  TEXT NOT NULL,
  house_number   TEXT NOT NULL,
  neighborhood   TEXT NOT NULL,
  municipality   TEXT NOT NULL,
  state          TEXT NOT NULL,
  cep            TEXT NOT NULL,
  email          TEXT NOT NULL,
  phone1         TEXT NOT NULL,
  phone2         TEXT NOT NULL
);

-- Registrations
CREATE TABLE registrations (
  id                     INTEGER NOT NULL PRIMARY KEY,
  enrollment_id          TEXT NOT NULL UNIQUE,
  course_id              INTEGER NOT NULL REFERENCES courses ON DELETE RESTRICT ON UPDATE RESTRICT,
  option                 INTEGER NOT NULL,
  languages_score        INTEGER NOT NULL,
  humanities_score       INTEGER NOT NULL,
  natural_sciences_score INTEGER NOT NULL,
  mathematics_score      INTEGER NOT NULL,
  essay_score            INTEGER NOT NULL,
  composite_score        INTEGER NOT NULL,
  ranking                INTEGER NOT NULL,
  selection_id           INTEGER NOT NULL REFERENCES selections ON DELETE RESTRICT ON UPDATE RESTRICT,
  candidate_id           INTEGER NOT NULL REFERENCES candidates ON DELETE CASCADE ON UPDATE RESTRICT
);

-- Call entries: one row per registration taking part in a call. Registrations
-- hold only imported data; everything that happens during the admission cycle
-- is recorded here, owned by the call that caused it. Deleting a call deletes
-- its entries, which reverts every effect of that call.
--
-- kind:     initial   = approved list, placed by the import (call 1)
--           waitlist  = called from the waitlist
--           promotion = semester-2 student offered a seat in semester 1
-- outcome:  pending | enrolled | absent (initial/waitlist)
--           pending | enrolled | declined (promotion; enrolled = accepted)
CREATE TABLE call_entries (
  call_id         INTEGER NOT NULL REFERENCES calls ON DELETE CASCADE ON UPDATE RESTRICT,
  registration_id INTEGER NOT NULL REFERENCES registrations ON DELETE CASCADE ON UPDATE RESTRICT,
  kind            TEXT NOT NULL CHECK (kind IN ('initial', 'waitlist', 'promotion')),
  semester        INTEGER NOT NULL REFERENCES semesters(number) ON DELETE RESTRICT ON UPDATE RESTRICT,
  outcome         TEXT NOT NULL CHECK (outcome IN ('pending', 'enrolled', 'absent', 'declined')),
  wants_promotion INTEGER NOT NULL DEFAULT 0 CHECK (wants_promotion IN (0, 1)),
  PRIMARY KEY (call_id, registration_id),
  CHECK (kind = 'promotion' OR outcome <> 'declined'),
  CHECK (kind <> 'promotion' OR outcome <> 'absent'),
  CHECK (wants_promotion = 0 OR (semester = 2 AND kind <> 'promotion'))
);

CREATE INDEX idx_call_entries_registration ON call_entries(registration_id);

-- Current placement of every registration, derived from its call entries: the
-- entry from the latest call, ignoring promotion offers that were not accepted
-- (a pending or declined offer leaves the student where they were).
-- No placement = never called (waitlisted).
CREATE VIEW registration_placements AS
SELECT
  r.id        AS registration_id,
  p.call_id   AS call_id,
  p.kind      AS kind,
  p.semester  AS semester,
  p.outcome   AS outcome
FROM registrations r
LEFT JOIN (
  SELECT
    ce.registration_id,
    ce.call_id,
    ce.kind,
    ce.semester,
    ce.outcome,
    ROW_NUMBER() OVER (PARTITION BY ce.registration_id ORDER BY c.number DESC) AS rn
  FROM call_entries ce
  INNER JOIN calls c ON c.id = ce.call_id
  WHERE ce.kind <> 'promotion' OR ce.outcome = 'enrolled'
) p ON p.registration_id = r.id AND p.rn = 1;
